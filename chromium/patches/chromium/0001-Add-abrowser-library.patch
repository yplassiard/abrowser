From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: abrowser <abrowser@example.com>
Date: Thu, 1 Jan 2025 00:00:00 +0000
Subject: [PATCH 1/3] Add abrowser library to Chromium build

Adds symlinks and build configuration to integrate the abrowser
Rust library with Chromium's headless shell.
---
 abrowser/build   |  1 +
 abrowser/src     |  1 +
 headless/BUILD.gn | 15 ++++++++++++++-
 3 files changed, 16 insertions(+), 1 deletion(-)
 create mode 120000 abrowser/build
 create mode 120000 abrowser/src

diff --git a/abrowser/build b/abrowser/build
new file mode 120000
index 0000000000000..44735d5866459
--- /dev/null
+++ b/abrowser/build
@@ -0,0 +1 @@
+../../../build
\ No newline at end of file
diff --git a/abrowser/src b/abrowser/src
new file mode 120000
index 0000000000000..dabb0e15a991e
--- /dev/null
+++ b/abrowser/src
@@ -0,0 +1 @@
+../../../src
\ No newline at end of file
diff --git a/headless/BUILD.gn b/headless/BUILD.gn
index bfae1e3290de0..8018111ed9898 100644
--- a/headless/BUILD.gn
+++ b/headless/BUILD.gn
@@ -453,6 +453,7 @@ component("headless_non_renderer") {
     "//build:branding_buildflags",
     "//build:branding_buildflags",
     "//build:chromeos_buildflags",
+    "//abrowser/src/browser:abrowser",
     "//components/cookie_config",
     "//components/crash/core/common:common",
     "//components/embedder_support",
@@ -993,13 +994,25 @@ static_library("headless_shell_lib") {
 }

 executable("headless_shell") {
+  if (is_mac && !use_lld) {
+    ldflags = [ "-Wl,-no_compact_unwind" ]
+  } else if (is_linux) {
+    ldflags = [
+      "-Wl,-rpath=\$ORIGIN/.",
+      "-Wl,-rpath-link=.",
+    ]
+  }
+
   configs -= [ "//build/config/compiler:thinlto_optimize_default" ]
   configs += [ "//build/config/compiler:thinlto_optimize_max" ]

   sources = [ "app/headless_shell_main.cc" ]
   defines = []

-  deps = [ ":headless_shell_lib" ]
+  deps = [
+    ":headless_shell_lib",
+    "//abrowser/src/browser:abrowser",
+  ]

   if (!headless_use_embedded_resources) {
     data = [
--
2.39.0

