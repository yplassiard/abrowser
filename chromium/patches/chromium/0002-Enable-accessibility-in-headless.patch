+std::vector<ui::AXNodeData> BrowserAccessibilityManager::GetAllNodeData() const {
+  std::vector<ui::AXNodeData> result;
+  if (!ax_tree())
+    return result;
+
+  const ui::AXNode* root = ax_tree()->root();
+  if (!root)
+    return result;
+
+  std::vector<const ui::AXNode*> nodes_to_process;
+  nodes_to_process.push_back(root);
+
+  while (!nodes_to_process.empty()) {
+    const ui::AXNode* node = nodes_to_process.back();
+    nodes_to_process.pop_back();
+    result.push_back(node->data());
+    for (const auto* child : node->children())
+      nodes_to_process.push_back(child);
+  }
+  return result;
+}
+
 BrowserAccessibility* BrowserAccessibilityManager::GetRoot() const {
   if (!ax_tree())
     return nullptr;
