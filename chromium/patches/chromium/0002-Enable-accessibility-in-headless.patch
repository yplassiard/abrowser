+void HeadlessBrowserImpl::InitializeAbrowser() {
+  // Force accessibility to be enabled
+  auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch("force-renderer-accessibility")) {
+    command_line->AppendSwitch("force-renderer-accessibility");
+  }
+
+  // Start the abrowser renderer
+  auto* renderer = abrowser::Renderer::GetCurrent();
+  renderer->Start();
