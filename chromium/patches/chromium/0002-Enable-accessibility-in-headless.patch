+void HeadlessWebContentsImpl::SetupAccessibilityBridge() {
+  if (!web_contents())
+    return;
+
+  auto* rfh = static_cast<content::RenderFrameHostImpl*>(
+      web_contents()->GetPrimaryMainFrame());
+  if (!rfh)
+    return;
+
+  // Set the accessibility update callback
+  rfh->SetAccessibilityUpdateCallback(
+      base::BindRepeating(&HeadlessWebContentsImpl::OnAccessibilityUpdate,
+                          weak_ptr_factory_.GetWeakPtr()));
+}
+
+void HeadlessWebContentsImpl::OnAccessibilityUpdate(
+    std::vector<ui::AXNodeData> nodes,
+    int32_t root_id) {
+  auto* renderer = abrowser::Renderer::GetCurrent();
+  if (!renderer)
+    return;
+
+  // Convert ui::AXNodeData to abrowser::AXNodeData
+  std::vector<abrowser::AXNodeData> abrowser_nodes;
+  abrowser_nodes.reserve(nodes.size());
+
+  for (const auto& node : nodes) {
+    abrowser::AXNodeData abrowser_node;
+    abrowser_node.id = node.id;
+    abrowser_node.role = static_cast<int32_t>(node.role);
+
+    // Extract name
+    if (node.HasStringAttribute(ax::mojom::StringAttribute::kName)) {
+      abrowser_node.name =
+          node.GetStringAttribute(ax::mojom::StringAttribute::kName);
+    }
+
+    // Extract description
+    if (node.HasStringAttribute(ax::mojom::StringAttribute::kDescription)) {
+      abrowser_node.description =
+          node.GetStringAttribute(ax::mojom::StringAttribute::kDescription);
+    }
+
+    // Extract value
+    if (node.HasStringAttribute(ax::mojom::StringAttribute::kValue)) {
+      abrowser_node.value =
+          node.GetStringAttribute(ax::mojom::StringAttribute::kValue);
+    }
+
+    // Extract URL for links
+    if (node.HasStringAttribute(ax::mojom::StringAttribute::kUrl)) {
+      abrowser_node.url =
+          node.GetStringAttribute(ax::mojom::StringAttribute::kUrl);
+    }
+
+    // Extract heading level
+    if (node.HasIntAttribute(ax::mojom::IntAttribute::kHierarchicalLevel)) {
+      abrowser_node.level = static_cast<uint8_t>(
+          node.GetIntAttribute(ax::mojom::IntAttribute::kHierarchicalLevel));
+    }
+
+    // Extract state flags
+    abrowser_node.focusable =
+        node.HasState(ax::mojom::State::kFocusable);
+    abrowser_node.focused =
+        node.HasState(ax::mojom::State::kFocused);
+
+    // Parent and children
+    abrowser_node.parent_id = 0;  // Will be set from tree structure
+    for (int32_t child_id : node.child_ids) {
+      abrowser_node.child_ids.push_back(child_id);
+    }
+
+    abrowser_nodes.push_back(std::move(abrowser_node));
+  }
+
+  // Send to renderer
+  renderer->UpdateAccessibilityTree(abrowser_nodes, root_id);
+}
+
