From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: abrowser <abrowser@example.com>
Date: Thu, 1 Jan 2025 00:00:00 +0000
Subject: [PATCH 1/3] Add abrowser library to Chromium build

Adds build configuration to integrate the abrowser Rust library
with Chromium's headless shell. Also disables Metal on macOS for
SDK compatibility.
---
 headless/BUILD.gn | 15 ++++++++++++++-
 skia/BUILD.gn     |  7 ++++---
 2 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/headless/BUILD.gn b/headless/BUILD.gn
index bfae1e3290..8caec4304b 100644
--- a/headless/BUILD.gn
+++ b/headless/BUILD.gn
@@ -453,6 +453,7 @@ component("headless_non_renderer") {
     "//build:branding_buildflags",
     "//build:branding_buildflags",
     "//build:chromeos_buildflags",
+    "//abrowser/src/browser:abrowser",
     "//components/cookie_config",
     "//components/crash/core/common:common",
     "//components/embedder_support",
@@ -993,13 +994,25 @@ static_library("headless_shell_lib") {
 }

 executable("headless_shell") {
+  if (is_mac && !use_lld) {
+    ldflags = [ "-Wl,-no_compact_unwind" ]
+  } else if (is_linux) {
+    ldflags = [
+      "-Wl,-rpath=\$ORIGIN/.",
+      "-Wl,-rpath-link=.",
+    ]
+  }
+
   configs -= [ "//build/config/compiler:thinlto_optimize_default" ]
   configs += [ "//build/config/compiler:thinlto_optimize_max" ]

   sources = [ "app/headless_shell_main.cc" ]
   defines = []

-  deps = [ ":headless_shell_lib" ]
+  deps = [
+    ":headless_shell_lib",
+    "//abrowser/src/browser:abrowser",
+  ]

   if (!headless_use_embedded_resources) {
     data = [
diff --git a/skia/BUILD.gn b/skia/BUILD.gn
index 1234567890..abcdef1234 100644
--- a/skia/BUILD.gn
+++ b/skia/BUILD.gn
@@ -531,12 +531,13 @@ component("skia") {
   }

   if (is_mac) {
-    deps += [ ":skia_metal" ]
-    defines += [ "SK_METAL" ]
+    # Disabled for SDK compatibility - Metal not needed for headless
+    # deps += [ ":skia_metal" ]
+    # defines += [ "SK_METAL" ]
     frameworks = [
       "AppKit.framework",
       "CoreFoundation.framework",
       "CoreGraphics.framework",
       "CoreText.framework",
-      "Metal.framework",
+      # "Metal.framework",
       "Foundation.framework",
     ]
   }
--
