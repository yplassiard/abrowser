+void HeadlessWebContentsImpl::TitleWasSet(content::NavigationEntry* entry) {
+  if (!web_contents() || !web_contents()->GetPrimaryMainFrame()->IsActive())
+    return;
+
+  auto* renderer = abrowser::Renderer::GetCurrent();
+  if (renderer && entry) {
+    renderer->SetTitle(base::UTF16ToUTF8(entry->GetTitleForDisplay()));
+  }
+}
+
+void HeadlessWebContentsImpl::DidFinishNavigation(
+    content::NavigationHandle* handle) {
+  if (!handle->IsInMainFrame() || !web_contents() ||
+      !web_contents()->GetPrimaryMainFrame()->IsActive())
+    return;
+
+  auto* renderer = abrowser::Renderer::GetCurrent();
+  if (!renderer)
+    return;
+
+  auto& nav = web_contents()->GetController();
+  renderer->PushNav(handle->GetURL().spec(), nav.CanGoBack(),
+                    nav.CanGoForward());
+
+  // Re-setup accessibility bridge after navigation
+  SetupAccessibilityBridge();
+
+  // Request initial accessibility tree
+  auto* rfh = static_cast<content::RenderFrameHostImpl*>(
+      web_contents()->GetPrimaryMainFrame());
+  if (rfh) {
+    rfh->NotifyAccessibilityUpdate();
+  }
+}
+
 HeadlessWebContentsImpl::~HeadlessWebContentsImpl() {
   web_contents_->Close();
   web_contents_.reset();
