 }

 void HeadlessBrowserImpl::RunOnStartCallback() {
+  abrowser_internal::g_browser = this;
+
+  // Handle terminal resize
+  signal(SIGWINCH, [](int) {
+    if (abrowser_internal::g_browser) {
+      abrowser_internal::g_browser->Resize();
+    }
+  });
+
+  // Start input listening thread
+  input_thread_ = std::thread([this]() {
+    abrowser_browser_delegate delegate = {
+        .shutdown = []() {
+          if (abrowser_internal::g_browser)
+            abrowser_internal::g_browser->OnShutdownInput();
+        },
+        .refresh = []() {
+          if (abrowser_internal::g_browser)
+            abrowser_internal::g_browser->OnRefreshInput();
+        },
+        .go_to = [](const char* url) {
+          if (abrowser_internal::g_browser)
+            abrowser_internal::g_browser->OnGoToInput(url);
+        },
+        .go_back = []() {
+          if (abrowser_internal::g_browser)
+            abrowser_internal::g_browser->OnGoBackInput();
+        },
+        .go_forward = []() {
+          if (abrowser_internal::g_browser)
+            abrowser_internal::g_browser->OnGoForwardInput();
+        },
+        .scroll = [](int delta) {
+          if (abrowser_internal::g_browser)
+            abrowser_internal::g_browser->OnScrollInput(delta);
+        },
+        .key_press = [](char key) {
+          if (abrowser_internal::g_browser)
+            abrowser_internal::g_browser->OnKeyPressInput(key);
+        },
+        .focus_node = [](int node_id) {
+          if (abrowser_internal::g_browser)
+            abrowser_internal::g_browser->OnFocusNodeInput(node_id);
+        },
+        .activate_node = [](int node_id) {
+          if (abrowser_internal::g_browser)
+            abrowser_internal::g_browser->OnActivateNodeInput(node_id);
+        },
+        .post_task = [](void (*fn)(void*), void* data) {
+          if (abrowser_internal::g_browser) {
+            abrowser_internal::g_browser->BrowserMainThread()->PostTask(
+                FROM_HERE, base::BindOnce(fn, data));
+          }
+        },
+    };
+
+    abrowser::Renderer::GetCurrent()->Listen(&delegate);
+  });
+
   // Original RunOnStartCallback code continues...
   agent_host_ = content::DevToolsAgentHost::CreateForBrowser(
       nullptr, content::DevToolsAgentHost::CreateServerSocketCallback());
