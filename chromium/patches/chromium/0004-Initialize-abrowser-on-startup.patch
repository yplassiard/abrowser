From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: abrowser <abrowser@example.com>
Date: Thu, 1 Jan 2025 00:00:00 +0000
Subject: [PATCH 2/3] Initialize abrowser on startup

Calls abrowser::Renderer::Main() early in headless_shell startup
to initialize the terminal UI before Chromium starts.
---
 headless/app/headless_shell_main.cc | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/headless/app/headless_shell_main.cc b/headless/app/headless_shell_main.cc
index 35736145f5..77da1f520e 100644
--- a/headless/app/headless_shell_main.cc
+++ b/headless/app/headless_shell_main.cc
@@ -13,7 +13,12 @@
 #include "sandbox/mac/seatbelt_exec.h"
 #endif

+// abrowser
+#include "abrowser/src/browser/renderer.h"
+
 int main(int argc, const char** argv) {
+  // Initialize abrowser before Chromium
+  abrowser::Renderer::Main();
 #if BUILDFLAG(IS_WIN)
   sandbox::SandboxInterfaceInfo sandbox_info = {nullptr};
   content::InitializeSandboxInfo(&sandbox_info);
--
