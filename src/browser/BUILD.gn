import("//build/config/compiler/compiler.gni")

# Configuration to link against the Rust abrowser library
config("lib") {
  target = ""

  if (current_cpu == "x64") {
    target += "x86_64-"
  } else if (current_cpu == "arm64") {
    target += "aarch64-"
  }

  if (is_mac) {
    target += "apple-darwin"
  } else if (is_linux) {
    target += "unknown-linux-gnu"
  }

  libs = ["abrowser"]
  lib_dirs = ["//abrowser/build/$target/release"]
}

# Export macros
source_set("export") {
  sources = [ "export.h" ]
}

# Static bridge for configuration
component("bridge") {
  output_name = "abrowser_bridge"
  defines = [ "ABROWSER_BRIDGE_IMPLEMENTATION" ]
  sources = [
    "bridge.cc",
    "bridge.h",
  ]
  deps = [ ":export" ]
}

# Main renderer/accessibility interface
component("renderer") {
  output_name = "abrowser_renderer"
  defines = [ "ABROWSER_RENDERER_IMPLEMENTATION" ]
  sources = [
    "renderer.cc",
    "renderer.h",
  ]

  configs += [ ":lib" ]
  deps = [
    ":bridge",
    ":export",
    "//base",
    "//content/public/browser",
    "//ui/accessibility",
  ]
}

# Combined target
group("abrowser") {
  deps = [
    ":bridge",
    ":renderer",
  ]
}
